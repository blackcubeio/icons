#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * @copyright 2010-2026 Blackcube - Philippe Gaultier
 * @license https://www.blackcube.io/license
 * @link https://www.blackcube.io
 */

/**
 * Regenerates the Heroicons sets from the official SVG files.
 *
 * Usage:
 *   bin/update-heroicons                     latest published version
 *   bin/update-heroicons 2.2.0               a given version
 *   bin/update-heroicons --source=/path      a heroicons directory already on disk
 *
 * Heroicons are the work of Tailwind Labs, Inc., released under the MIT
 * License (see LICENSE-heroicons.md). This script only repackages them.
 *
 * The custom icons - customicons/ui, customicons/logo - are never touched:
 * they do not come from Heroicons.
 */

$resourcesDir = __DIR__ . '/../src/resources/heroicons';

/** The four sets: directory inside the Heroicons archive, then destination. */
$sets = [
    [
        'source' => '24/outline',
        'size' => 'normal',
        'type' => 'outline',
    ],
    [
        'source' => '24/solid',
        'size' => 'normal',
        'type' => 'solid',
    ],
    [
        'source' => '20/solid',
        'size' => 'mini',
        'type' => 'solid',
    ],
    [
        'source' => '16/solid',
        'size' => 'micro',
        'type' => 'solid',
    ],
];

/**
 * The inner content of an SVG: what lives between the <svg> tags, which the
 * Svg class uses to compose the icon with its own attributes.
 *
 * @return string[]
 */
function innerSvg(string $file): array
{
    $svg = file_get_contents($file);
    $parts = [];

    if ($svg !== false && preg_match('#<svg[^>]*>(.*)</svg>#s', $svg, $matches) === 1) {
        $inner = trim($matches[1]);
        if (preg_match_all('#<(path|circle|rect|g|line|polyline|polygon|ellipse)\b[^>]*/?>#s', $inner, $elements) === 1
            || $elements[0] !== []
        ) {
            foreach ($elements[0] as $element) {
                $parts[] = preg_replace('/\s+/', ' ', trim($element));
            }
        }
    }

    return $parts;
}

/**
 * Writes a set in the format expected by Blackcube\Icons\Svg.
 *
 * The file carries the Blackcube header; the docblock after it credits the SVG
 * source: the icon paths are the work of Tailwind Labs, under the MIT License.
 */
function writeSet(string $path, string $type, array $icons, string $version): int
{
    $lines = [
        '<?php',
        '',
        'declare(strict_types=1);',
        '',
        '/**',
        ' * @copyright 2010-2026 Blackcube - Philippe Gaultier',
        ' * @license https://www.blackcube.io/license',
        ' * @link https://www.blackcube.io',
        ' */',
        '',
        '/**',
        ' * SVG source: Heroicons ' . $version . ' - https://heroicons.com/',
        ' * Copyright (c) Tailwind Labs, Inc., released under the MIT License, see LICENSE-heroicons.md.',
        ' * Generated by bin/update-heroicons from the official SVG files.',
        ' */',
        '',
        'return [',
    ];

    foreach ($icons as $name => $parts) {
        $lines[] = "    '" . $name . "' => [";
        foreach ($parts as $part) {
            $lines[] = "        '" . str_replace("'", "\\'", $part) . "',";
        }
        $lines[] = '    ],';
    }

    $lines[] = '];';

    file_put_contents($path, implode("\n", $lines) . "\n");

    return count($icons);
}

// ---------------------------------------------------------------- arguments

$source = null;
$version = 'latest';

foreach (array_slice($argv, 1) as $argument) {
    if (str_starts_with($argument, '--source=') === true) {
        $source = substr($argument, 9);
    } else {
        $version = $argument;
    }
}

$temporaryDir = null;
$resolved = $version === 'latest' ? 'local copy, version unknown' : $version;

if ($source === null) {
    $temporaryDir = sys_get_temp_dir() . '/heroicons-' . bin2hex(random_bytes(6));
    mkdir($temporaryDir, 0o777, true);

    echo 'Downloading heroicons@' . $version . PHP_EOL;

    $metadata = @file_get_contents('https://registry.npmjs.org/heroicons/' . $version);
    if ($metadata === false) {
        fwrite(STDERR, 'Cannot reach the npm registry.' . PHP_EOL);
        exit(1);
    }

    $package = json_decode($metadata, true);
    $tarball = $package['dist']['tarball'] ?? null;
    $resolved = $package['version'] ?? $version;

    if ($tarball === null) {
        fwrite(STDERR, 'No tarball found for heroicons@' . $version . PHP_EOL);
        exit(1);
    }

    $archive = $temporaryDir . '/heroicons.tgz';
    copy($tarball, $archive);
    exec('tar -xzf ' . escapeshellarg($archive) . ' -C ' . escapeshellarg($temporaryDir), $output, $status);

    if ($status !== 0) {
        fwrite(STDERR, 'Extraction failed.' . PHP_EOL);
        exit(1);
    }

    $source = $temporaryDir . '/package';
    echo 'Version ' . $resolved . PHP_EOL;
}

if (is_dir($source) === false) {
    fwrite(STDERR, 'Source not found: ' . $source . PHP_EOL);
    exit(1);
}

// ------------------------------------------------------------------ generation

$status = 0;

foreach ($sets as $set) {
    $directory = $source . '/' . $set['source'];

    if (is_dir($directory) === false) {
        fwrite(STDERR, 'Set missing from the source: ' . $set['source'] . PHP_EOL);
        $status = 1;
    } else {
        $icons = [];
        $files = glob($directory . '/*.svg');
        sort($files);

        foreach ($files as $file) {
            $name = basename($file, '.svg');
            $parts = innerSvg($file);

            if ($parts === []) {
                fwrite(STDERR, 'Unreadable SVG: ' . $file . PHP_EOL);
                $status = 1;
            } else {
                $icons[$name] = $parts;
            }
        }

        $target = $resourcesDir . '/' . $set['size'] . '/' . $set['type'] . '.php';
        $count = writeSet($target, $set['type'], $icons, $resolved);

        printf("%-16s %4d icons → %s\n", $set['source'], $count, $set['size'] . '/' . $set['type'] . '.php');
    }
}

if ($temporaryDir !== null) {
    exec('rm -rf ' . escapeshellarg($temporaryDir));
}

exit($status);
